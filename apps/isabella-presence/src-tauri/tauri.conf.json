{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Isabella Presence",
  "version": "0.1.0",
  "identifier": "com.minds.isabella.presence",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "presence",
        "title": "Isabella",
        "width": 420,
        "height": 430,
        "center": true,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": true,
        "focus": true,
        "shadow": true
      }
    ],
    "security": {
      "capabilities": ["presence"],
      "csp": "default-src 'self'; script-src 'self' https://cdn.jsdelivr.net; style-src 'self'; connect-src 'self' https://lodexwyyynlarkqgkyhy.supabase.co; img-src 'self' data:; font-src 'self'; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}
