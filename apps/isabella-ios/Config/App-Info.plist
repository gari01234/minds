     which left build 7 without its backend URL ("Falta configurar MINDS"). -->
<plist version="1.0">
<dict>
	<key>SUPABASE_URL</key>
	<string>https://lodexwyyynlarkqgkyhy.supabase.co</string>
	<key>SUPABASE_ANON_KEY</key>
	<string>$(SUPABASE_ANON_KEY)</string>
	<key>MINDSAppGroupID</key>
	<string>group.$(MINDS_BUNDLE_ID)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
